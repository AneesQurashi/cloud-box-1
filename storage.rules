rules_version = '2';

// CloudBox — Cloud Storage security rules
// Every file lives under  users/{uid}/...  and only that user may touch it.
// Public downloads of shared files use Firebase Storage download tokens
// (unguessable) so we don't need a public read rule here.

service firebase.storage {
  match /b/{bucket}/o {

    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024 * 1024; // 2 GB
    }
  }
}
